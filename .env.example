# Generate a unique value before starting. Never use this placeholder.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100,http://127.0.0.1:3000,http://localhost:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100,http://127.0.0.1:3000,http://localhost:3000
POSTGRES_DB=learnmore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
# False on local HTTP only; production defaults are secure when DEBUG=false.
DJANGO_SECURE_SSL_REDIRECT=false

# WhatsApp defaults to simulation. Enable live sends only after explicit approval.
WHATSAPP_MODE=mock
WHATSAPP_LIVE_SENDS_ENABLED=false
# Pin a currently supported Meta Graph API version before live template sync/use.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Independent server-to-server form webhook secrets (never NEXT_PUBLIC_*).
WEBSITE_LEARNMORETECH_SECRET=
WEBSITE_LEARNMORETECHNOLOGIES_SECRET=

# Google Contacts: credentials and encryption key are server-only. No NEXT_PUBLIC_* secrets.
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_ENCRYPTION_KEY=
GOOGLE_CONTACTS_REDIRECT_URI=http://127.0.0.1:3100/api/v1/integrations/google-contacts/callback/
GOOGLE_CONTACTS_CRM_ORIGIN=http://127.0.0.1:3100
# Recommended: restrict authorization to the shared company Google account.
GOOGLE_CONTACTS_EXPECTED_EMAIL=
